cabal-version: 3.6

name:           okapi
version:        0.2.0.0
synopsis:       A bidirectional HTTP description language
description:    Please see the README on GitHub at <https://github.com/monadicsystems/okapi#readme>
category:       Web
homepage:       https://github.com/monadicsystems/okapi#readme
bug-reports:    https://github.com/monadicsystems/okapi/issues
author:         Monadic Systems LLC
maintainer:     info@monadic.systems
copyright:      2026 Monadic Systems LLC
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
tested-with:    GHC ==9.10.1
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/monadicsystems/okapi

common warnings
    ghc-options: -Wall

common ghc-extensions
    default-extensions:
        TypeFamilies
        OverloadedStrings
        OverloadedRecordDot

library
    import:           warnings, ghc-extensions
    exposed-modules:
        Okapi
        Okapi.Client
        Okapi.Server
        Okapi.Function
        Okapi.Link
        Okapi.OpenApi
        Okapi.Transformer
        Okapi.Contract
        Okapi.Tree
        Okapi.HTTP.Headers
        Okapi.HTTP.Body
        Okapi.HTTP.Request
        Okapi.HTTP.Method
        Okapi.HTTP.Path
        Okapi.HTTP.Query
        Okapi.HTTP.Cookie
        Okapi.HTTP.Response
        Okapi.HTTP.Status
        Okapi.HTTP.SetCookie
        Okapi.HTTP.Attributes
        Okapi.HTTP.Responses
        Okapi.HTTP.SFV
        Okapi.HTTP.SFV.Scan
        Okapi.HTTP.SFV.Bare
        Okapi.HTTP.SFV.Parameters
        Okapi.HTTP.SFV.Item
        Okapi.HTTP.SFV.List
        Okapi.HTTP.SFV.Dictionary
    build-depends:
        base                     ^>=4.20.0.0,
        aeson                    ^>=2.2,
        base64-bytestring        ^>=1.2,
        bytestring               ^>=0.12,
        case-insensitive         ^>=1.2,
        cookie                   ^>=0.5,
        http-api-data            ^>=0.7,
        http-client              ^>=0.7,
        http-media               ^>=0.8,
        http-types               ^>=0.12,
        insert-ordered-containers ^>=0.2,
        optics-core              ^>=0.4,
        openapi3                 ^>=3.2,
        profunctors              ^>=5.6,
        scientific               ^>=0.3,
        text                     ^>=2.1,
        time                     ^>=1.12,
        uuid                     ^>=1.3,
        wai                      ^>=3.2
    hs-source-dirs:   src
    default-language: GHC2024

test-suite okapi-doctests
    import:           warnings, ghc-extensions
    type:             exitcode-stdio-1.0
    main-is:          Doctests.hs
    hs-source-dirs:   test
    build-depends:
        base ^>=4.20.0.0,
        doctest-parallel,
        QuickCheck,
        quickcheck-instances,
        time,
        okapi
    default-language: GHC2024

-- Deliberately an `executable`, not a `test-suite` — this example calls a
-- real external API with a real credential, and must never be swept up in
-- an automatic `cabal test all` run.
executable okapi-ex1
    import:           warnings, ghc-extensions
    ghc-options:      -threaded
    main-is:          Ex1.hs
    hs-source-dirs:   test
    build-depends:
        base ^>=4.20.0.0,
        aeson,
        bytestring,
        http-client,
        http-client-tls,
        http-types,
        openapi3,
        text,
        okapi
    default-language: GHC2024

