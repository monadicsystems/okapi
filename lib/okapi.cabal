cabal-version: 3.6

name:           okapi
version:        0.2.0.0
synopsis:       A bidirectional HTTP description language
description:    Please see the README on GitHub at <https://github.com/monadicsystems/okapi#readme>
category:       Web
homepage:       https://github.com/monadicsystems/okapi#readme
bug-reports:    https://github.com/monadicsystems/okapi/issues
author:         Monadic Systems LLC
maintainer:     info@monadic.systems
copyright:      2026 Monadic Systems LLC
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
tested-with:    GHC ==9.10.1
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/monadicsystems/okapi

common warnings
    ghc-options: -Wall

common ghc-extensions
    default-extensions:
        TypeFamilies
        OverloadedStrings
        OverloadedRecordDot

library
    import:           warnings, ghc-extensions
    exposed-modules:
        Okapi
        Okapi.Tree
        Okapi.Mode.Forest
        Okapi.Mode.Server
        Okapi.Mode.Client
        Okapi.Handle
        Okapi.Mode.Link
        Okapi.Artifact.OpenApi
        Okapi.Record.Tree
        Okapi.Record.Failure
        Okapi.Record.Result
        Okapi.Record.Data
        Okapi.HTTP.Headers
        Okapi.HTTP.Body
        Okapi.HTTP.Request
        Okapi.HTTP.Request.Method
        Okapi.HTTP.Request.Path
        Okapi.HTTP.Request.Query
        Okapi.HTTP.Request.Headers
        Okapi.HTTP.Request.Body
        Okapi.HTTP.Response
        Okapi.HTTP.Response.Status
        Okapi.HTTP.Response.Headers
        Okapi.HTTP.Response.Body
        Okapi.HTTP.Responses
        Okapi.HTTP.Request.Cookies
        Okapi.HTTP.Response.SetCookies
        Okapi.HTTP.Response.Attributes
        Okapi.HTTP.RFC9651
        Okapi.HTTP.RFC9651.Lexer
        Okapi.HTTP.RFC9651.BareItem
        Okapi.HTTP.RFC9651.Parameters
        Okapi.HTTP.RFC9651.Item
        Okapi.HTTP.RFC9651.List
        Okapi.HTTP.RFC9651.Dictionary
    build-depends:
        base                     ^>=4.20.0.0,
        aeson                    ^>=2.2,
        bytestring               ^>=0.12,
        case-insensitive         ^>=1.2,
        cookie                   ^>=0.5,
        http-api-data            ^>=0.7,
        http-client              ^>=0.7,
        http-media               ^>=0.8,
        http-types               ^>=0.12,
        insert-ordered-containers ^>=0.2,
        lucid                    ^>=2.11,
        optics-core              ^>=0.4,
        openapi3                 ^>=3.2,
        profunctors              ^>=5.6,
        scientific               ^>=0.3,
        text                     ^>=2.1,
        time                     ^>=1.12,
        uuid                     ^>=1.3,
        vector                   ^>=0.13,
        wai                      ^>=3.2
    hs-source-dirs:   src
    default-language: GHC2024

test-suite okapi-doctests
    import:           warnings, ghc-extensions
    type:             exitcode-stdio-1.0
    main-is:          Doctests.hs
    hs-source-dirs:   test
    build-depends:
        base ^>=4.20.0.0,
        doctest-parallel,
        okapi
    default-language: GHC2024

